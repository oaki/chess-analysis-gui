{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "isolatedModules": false,
    "target": "ES2020",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
